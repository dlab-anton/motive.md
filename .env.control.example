# Copy to a gitignored file used only by the control-plane command. The existing
# `npm run dev` command remains the local Vite + Express/SQLite prototype.
NODE_ENV=development
HOST=127.0.0.1
PORT=4320
CONTROL_ALLOWED_ORIGINS=http://127.0.0.1:4317,http://localhost:4317
CONTROL_BUILD_ID=development
CONTROL_SHUTDOWN_GRACE_MS=20000
CONTROL_HEALTH_PROBE_INTERVAL_MS=5000
CONTROL_HEALTH_PROBE_TIMEOUT_MS=2000

# Required for the production-path control service. Use a direct connection or
# Supavisor session pooler; transaction-mode pooling is intentionally rejected.
DATABASE_URL=
DATABASE_CONNECTION_MODE=direct
DATABASE_CA_CERT=
DATABASE_POOL_MAX=5
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# Test runner only. Use a disposable database with no customer or cloud data.
MOTIVE_TEST_DATABASE_URL=

# Required read/auth inputs. These values identify the matching Supabase project.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Optional until the sealed-artifact Storage adapter is enabled. Configure both.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Optional until the Trigger.dev dispatcher adapter is enabled. Configure both.
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_REF=
