{
  "name": "motive-md",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:mcp": "node --import tsx scripts/agent-mcp-config.ts",
    "project:reviewer": "node --env-file-if-exists=.env.local --import tsx scripts/set-project-reviewer.ts",
    "project:research": "node --env-file-if-exists=.env.local --import tsx scripts/link-project-research.ts",
    "project:research-sync": "node --env-file-if-exists=.env.local --import tsx scripts/sync-project-research.ts",
    "project:funded-work": "node --env-file-if-exists=.env.local --import tsx scripts/prepare-circle-funded-work.ts",
    "project:discovery-readiness": "node --env-file-if-exists=.env.local --import tsx scripts/check-discovery-readiness.ts",
    "project:dispatch-wakes": "node --env-file-if-exists=.env.local --import tsx scripts/dispatch-circle-attempt-wakes.ts",
    "openrouter:probe-live-route": "node --import tsx scripts/probe-openrouter-live-route.ts",
    "docker:cleanup-motive": "node --import tsx scripts/cleanup-motive-docker.ts",
    "rehearsal:participation": "node --env-file-if-exists=.env.local --import tsx scripts/rehearse-participation.ts",
    "rehearsal:learning-loop": "node --import tsx scripts/learning-loop-rehearsal.ts",
    "dev": "concurrently -k -n web,api \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite --host 127.0.0.1 --port 4317 --strictPort",
    "dev:api": "node --env-file-if-exists=.env.local --import tsx server/index.ts",
    "dev:control": "node --env-file-if-exists=.env.control --import tsx server/control/index.ts",
    "start:control": "node --import tsx server/control/index.ts",
    "seed:control": "node --env-file-if-exists=.env.control --import tsx scripts/seed-control-project.ts",
    "db:migrate": "node --env-file-if-exists=.env.control --import tsx scripts/migrate-postgres.ts",
    "db:check": "node --env-file-if-exists=.env.control --import tsx scripts/migrate-postgres.ts --check",
    "start": "npm run dev",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "check:circle-packing": "node --import tsx scripts/check-circle-packing.ts",
    "check:matmul": "node --import tsx scripts/check-matmul.ts",
    "reference:matmul": "node --import tsx scripts/freeze-matmul-reference.ts",
    "test": "vitest run src/lib",
    "test:backend": "vitest run tests/backend --no-file-parallelism",
    "test:compatibility": "vitest run packages/runner-codex packages/evaluator-lean",
    "compatibility:preflight": "node --import tsx scripts/compatibility-preflight.ts",
    "gateway:preflight": "node --import tsx scripts/gateway-preflight.ts",
    "gateway:preflight:linux": "node --import tsx scripts/codex-linux-gateway-preflight.ts",
    "test:e2e": "playwright test",
    "preview": "concurrently -k -n web,api \"vite preview --host 127.0.0.1 --port 4317 --strictPort\" \"npm:dev:api\"",
    "check:publication": "node scripts/check-publication.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@supabase/supabase-js": "2.115.0",
    "@trigger.dev/sdk": "4.5.16",
    "@vercel/functions": "3.9.5",
    "@vercel/sandbox": "3.2.2",
    "better-auth": "^1.7.2",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.5",
    "decimal.js": "10.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "8.7.0",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@trigger.dev/build": "4.5.16",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0",
    "@opentelemetry/sdk-metrics": "2.8.0",
    "@opentelemetry/otlp-transformer": "0.219.0",
    "@opentelemetry/otlp-exporter-base": "0.219.0",
    "@opentelemetry/sdk-trace-node": "2.8.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.219.0",
    "@opentelemetry/core": "2.8.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.219.0",
    "@opentelemetry/sdk-trace-base": "2.8.0",
    "@opentelemetry/sdk-logs": "0.219.0",
    "@opentelemetry/api-logs": "0.219.0",
    "@opentelemetry/instrumentation": "0.219.0",
    "@opentelemetry/resources": "2.8.0",
    "ws": "8.21.0",
    "@opentelemetry/exporter-logs-otlp-http": "0.219.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dlab-anton/motive.md.git"
  },
  "homepage": "https://motive-md.vercel.app"
}
