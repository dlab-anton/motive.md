{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "allowImportingTsExtensions": true,
    "paths": { "@/*": ["./src/*"] }, "types": ["vite/client"]
  },
  "include": ["src", "server", "api", "packages", "scripts", "tests/backend", "trigger", "trigger.config.ts", "vite.config.ts"]
}
