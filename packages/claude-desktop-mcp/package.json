{
  "name": "@motive-md/claude-desktop-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claude Desktop extension for Motive's circle-packing contributor API",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "pack:mcpb": "npm run build && mcpb pack .mcpb-stage dist/motive-claude-desktop.mcpb"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/node": "26.5.1",
    "esbuild": "0.28.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
